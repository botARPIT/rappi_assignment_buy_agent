# Copy to .env. The scripted demo runs without a model service or credentials.
# Use ollama for independent LLM reasoning; see README for model setup.
AGENT_PROVIDER=scripted
AGENT_MODEL=gpt-oss:20b-cloud
# Native Python uses OLLAMA_BASE_URL. Compose uses DOCKER_OLLAMA_BASE_URL instead.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCKER_OLLAMA_BASE_URL=http://ollama:11434
# Native bind address; Compose always listens on 0.0.0.0 inside its container.
HOST=127.0.0.1
# Native port / Docker's published localhost port (container port stays 8000).
PORT=8000
# Every DeepEval run (including scripted) requires a real, reachable judge.
# No --judge flag is needed. If omitted, this defaults to AGENT_MODEL.
DEEPEVAL_JUDGE_MODEL=gpt-oss:20b-cloud
DEEPEVAL_TELEMETRY_OPT_OUT=YES
