# Copy to .env. No model API secrets are needed when using a running local Ollama service.
AGENT_PROVIDER=ollama
AGENT_MODEL=gpt-oss:20b-cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434
PORT=8000
# AGENT_PROVIDER=scripted is a clearly labelled deterministic development/test mode.
# Optional model judge for DeepEval --judge; defaults to the agent model.
DEEPEVAL_JUDGE_MODEL=gpt-oss:20b-cloud
DEEPEVAL_TELEMETRY_OPT_OUT=YES
